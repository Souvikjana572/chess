<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>janaChess - Premium Multiplayer Chess</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Outfit', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom Chessboard Styling */
        .chessboard {
            display: grid;
            grid-template-columns: repeat(8, minmax(0, 1fr));
            grid-template-rows: repeat(8, minmax(0, 1fr));
            width: 100%;
            aspect-ratio: 1 / 1;
            max-width: 540px;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6), 0 0 40px rgba(16, 185, 129, 0.1);
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            border: 4px solid #27272a;
        }

        .square {
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            transition: background-color 0.2s ease;
        }

        /* Lichess/Chess.com Emerald Green & Cream */
        .square.light {
            background-color: #eeeed2;
        }

        .square.dark {
            background-color: #769656;
        }

        .square:hover {
            filter: brightness(1.04);
        }

        .piece {
            font-size: 5.5vw;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
            user-select: none;
            transition: transform 0.2s ease, opacity 0.2s ease;
            z-index: 10;
        }

        @media (min-width: 640px) {
            .piece {
                font-size: 46px;
            }
        }

        .piece.white {
            color: #f8f9fa;
            filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.4)) drop-shadow(0 0 1px rgba(0, 0, 0, 0.6));
        }

        .piece.black {
            color: #1a1a1a;
            filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.3)) drop-shadow(0 0 1px rgba(0, 0, 0, 0.5));
        }

        .piece.draggable {
            cursor: grab;
        }

        .piece.draggable:active {
            cursor: grabbing;
        }

        .dragging {
            opacity: 0.4;
            transform: scale(1.15);
        }

        .flipped {
            transform: rotate(180deg);
        }

        .flipped .piece {
            transform: rotate(180deg);
        }

        /* Glassmorphism custom scrollbar */
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: rgba(24, 24, 27, 0.3);
            border-radius: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(63, 63, 70, 0.8);
            border-radius: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: rgba(82, 82, 91, 0.8);
        }

        /* Pulsing Glow Animation */
        @keyframes pulse-glow {
            0%, 100% {
                box-shadow: 0 0 5px rgba(16, 185, 129, 0.2), 0 0 10px rgba(16, 185, 129, 0.1);
            }
            50% {
                box-shadow: 0 0 15px rgba(16, 185, 129, 0.5), 0 0 25px rgba(16, 185, 129, 0.3);
            }
        }
        .active-turn-glow {
            animation: pulse-glow 2s infinite;
        }
    </style>
</head>
<body class="bg-zinc-950 text-zinc-100 font-sans min-h-screen flex flex-col justify-between overflow-x-hidden relative">
    
    <!-- Background Ambient Glows -->
    <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] rounded-full bg-emerald-900/10 blur-[120px] pointer-events-none z-0"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] rounded-full bg-blue-900/10 blur-[120px] pointer-events-none z-0"></div>

    <!-- Header / Nav -->
    <header class="w-full border-b border-zinc-900 bg-zinc-950/80 backdrop-blur-md px-6 py-4 flex items-center justify-between z-10 relative">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-emerald-500 to-teal-400 flex items-center justify-center shadow-lg shadow-emerald-500/20">
                <span class="text-zinc-950 font-display font-black text-lg">jC</span>
            </div>
            <span class="font-display font-bold text-xl tracking-tight bg-gradient-to-r from-emerald-400 via-teal-400 to-blue-400 bg-clip-text text-transparent">janaChess</span>
        </div>
        <div class="flex items-center gap-4">
            <span id="role-badge" class="px-3 py-1 text-xs font-medium bg-zinc-900 border border-zinc-800 rounded-full text-zinc-400 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-zinc-600"></span> Connecting...
            </span>
        </div>
    </header>

    <!-- Main Content Grid -->
    <main class="flex-grow w-full max-w-7xl mx-auto px-4 py-6 md:py-10 flex flex-col md:grid md:grid-cols-[1fr_380px] gap-8 items-center md:items-start justify-center z-10 relative">
        
        <!-- Left Column: Chessboard Area -->
        <div class="w-full flex flex-col items-center justify-center gap-4">
            <!-- Opponent Status -->
            <div class="w-full max-w-[540px] flex items-center justify-between px-2 text-sm text-zinc-400">
                <div class="flex items-center gap-2">
                    <div id="opp-avatar" class="w-6 h-6 rounded bg-zinc-800 flex items-center justify-center text-xs font-bold text-zinc-300">O</div>
                    <span id="opp-username" class="font-medium text-zinc-300">Opponent</span>
                </div>
                <div id="opp-captured" class="flex gap-0.5 text-lg font-normal tracking-tighter opacity-85"></div>
            </div>

            <!-- Chessboard -->
            <div class="chessboard" id="chessboard"></div>

            <!-- Player Status -->
            <div class="w-full max-w-[540px] flex items-center justify-between px-2 text-sm text-zinc-400">
                <div class="flex items-center gap-2">
                    <div id="player-avatar" class="w-6 h-6 rounded bg-emerald-950 border border-emerald-800/50 flex items-center justify-center text-xs font-bold text-emerald-400">Y</div>
                    <span id="player-username" class="font-medium text-zinc-300">You (Connecting)</span>
                </div>
                <div id="player-captured" class="flex gap-0.5 text-lg font-normal tracking-tighter opacity-85"></div>
            </div>
        </div>

        <!-- Right Column: Info & Controls Sidebar -->
        <div class="w-full max-w-[540px] md:max-w-none flex flex-col gap-6 self-stretch">
            
            <!-- Game Status Panel -->
            <div class="bg-zinc-900/40 border border-zinc-800/80 backdrop-blur-md rounded-2xl p-6 flex flex-col gap-5 shadow-xl">
                <div>
                    <h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 mb-2">Game Status</h3>
                    <div class="flex items-center justify-between">
                        <!-- Turn indicator -->
                        <div id="turn-card" class="px-4 py-2 bg-zinc-900 border border-zinc-800 rounded-xl flex items-center gap-3">
                            <span id="turn-dot" class="w-3 h-3 rounded-full bg-zinc-600"></span>
                            <span id="turn-label" class="font-medium text-sm text-zinc-300">Waiting...</span>
                        </div>
                        <!-- Status text -->
                        <span id="status-alert" class="text-xs text-emerald-400 font-medium bg-emerald-950/30 border border-emerald-900/30 px-3 py-1.5 rounded-lg hidden">
                            CHECK
                        </span>
                    </div>
                </div>

                <hr class="border-zinc-800/50">

                <!-- Move History -->
                <div>
                    <h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 mb-3 flex items-center justify-between">
                        <span>Move History</span>
                        <span id="move-count" class="text-zinc-600 text-xxs font-mono">0 moves</span>
                    </h3>
                    <div class="bg-zinc-950/60 border border-zinc-900 rounded-xl p-3 h-48 overflow-y-auto custom-scrollbar" id="move-history-container">
                        <div id="move-history-empty" class="h-full flex flex-col items-center justify-center text-center p-4">
                            <svg class="w-8 h-8 text-zinc-700 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
                            </svg>
                            <p class="text-xs text-zinc-600">No moves played yet. Start dragging pieces to play!</p>
                        </div>
                        <div id="move-history-grid" class="grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm font-mono text-zinc-400 hidden">
                            <!-- Populated dynamically: Odd numbers (White) on left, Even numbers (Black) on right -->
                        </div>
                    </div>
                </div>

                <hr class="border-zinc-800/50">

                <!-- Controls -->
                <div class="flex gap-3">
                    <button id="btn-flip-board" class="flex-1 py-2.5 px-4 bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-zinc-300 hover:text-zinc-100 rounded-xl text-xs font-semibold transition-colors flex items-center justify-center gap-2 shadow-sm">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 8H18.2"></path>
                        </svg>
                        Flip View
                    </button>
                    <button id="btn-copy-link" class="py-2.5 px-4 bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-zinc-300 hover:text-zinc-100 rounded-xl text-xs font-semibold transition-colors flex items-center justify-center gap-2 shadow-sm">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
                        </svg>
                        Invite Link
                    </button>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="w-full border-t border-zinc-900/60 bg-zinc-950 py-4 px-6 text-center text-xs text-zinc-600 z-10 relative">
        <p>© 2026 janaChess. Server authoritative move validation. Powered by chess.js & socket.io.</p>
    </footer>

    <!-- Game Over Glass Modal -->
    <div id="game-over-popup" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center hidden">
        <div class="bg-zinc-900 border border-zinc-800 max-w-sm w-full mx-4 rounded-2xl p-6 shadow-2xl text-center flex flex-col gap-4 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-500 via-teal-400 to-blue-500"></div>
            <div class="w-12 h-12 bg-zinc-800 rounded-full flex items-center justify-center mx-auto text-emerald-400 mb-2">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                </svg>
            </div>
            <h2 class="font-display font-extrabold text-2xl text-zinc-100">Game Over</h2>
            <p id="popup-message" class="text-zinc-400 text-sm leading-relaxed"></p>
            <button id="close-popup" class="mt-2 w-full py-2.5 bg-zinc-800 hover:bg-zinc-750 border border-zinc-700 hover:border-zinc-600 text-zinc-100 font-medium rounded-xl text-sm transition-colors shadow-sm">
                Close Notification
            </button>
        </div>
    </div>

    <!-- Socket.IO & Frontend Game Script -->
    <script src="/socket.io/socket.io.js"></script>
    <script type="module" src="/js/chessGame.js"></script>
</body>
</html>
